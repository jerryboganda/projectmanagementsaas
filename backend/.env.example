# Linear Precision PM SaaS — Environment Variables
# Copy this file to .env and fill in the values for your environment.

# PostgreSQL
POSTGRES_DB=linearprecision
POSTGRES_USER=lp
POSTGRES_PASSWORD=dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Connection Strings (used by Api and Worker)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=linearprecision;Username=lp;Password=dev
ConnectionStrings__Redis=localhost:6379

# JWT Authentication
Jwt__Key=super-secret-development-key-that-is-at-least-32-bytes-long!
Jwt__Issuer=https://api.linearprecision.com
Jwt__Audience=linear-precision-api
Jwt__AccessTokenLifetimeMinutes=15
Jwt__RefreshTokenLifetimeDays=7

# CORS
Cors__AllowedOrigins__0=http://localhost:3000

# MinIO / S3 File Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
Storage__Endpoint=localhost:9000
Storage__AccessKey=minioadmin
Storage__SecretKey=minioadmin
Storage__BucketName=linearprecision
Storage__UseSSL=false

# Stripe Billing (leave empty for dev)
Stripe__SecretKey=
Stripe__WebhookSecret=
Stripe__PublishableKey=

# Email (SMTP via MailKit — leave empty to disable in dev)
Email__SmtpHost=
Email__SmtpPort=587
Email__SmtpUsername=
Email__SmtpPassword=
Email__FromAddress=noreply@linearprecision.com
Email__FromName=Linear Precision

# OpenAI (for AI module — leave empty to disable)
AI__OpenAIApiKey=
AI__Model=gpt-4o

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
