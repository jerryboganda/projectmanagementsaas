# Frontend runtime endpoints for live API and SignalR connections.
NEXT_PUBLIC_API_BASE_URL="http://localhost:5000"
NEXT_PUBLIC_SIGNALR_BASE_URL="http://localhost:5000"

# --- Backend Configuration (Docker Desktop Production deployment) ---
# All values below are REQUIRED. docker-compose.prod.yml uses ${VAR:?...} so
# missing values fail compose up. Generate fresh secrets per environment.
# Example: openssl rand -base64 48
ASPNETCORE_ENVIRONMENT=Production

# Auth (JWT) - MUST be a high-entropy string of at least 32 bytes.
JWT_KEY="REPLACE_ME_WITH_OPENSSL_RAND_BASE64_48"
JWT_ISSUER="https://api.your-domain.example"
JWT_AUDIENCE="linear-precision-api"

# Postgres - MUST be a strong unique password per environment.
POSTGRES_DB="linearprecision"
POSTGRES_USER="lp"
POSTGRES_PASSWORD="REPLACE_ME_STRONG_DB_PASSWORD"

# Object Storage (MinIO) - MUST be unique credentials per environment.
MINIO_ROOT_USER="REPLACE_ME_MINIO_USER"
MINIO_ROOT_PASSWORD="REPLACE_ME_STRONG_MINIO_PASSWORD"
MINIO_BUCKET="linear-precision"

# CORS - the public origin where the frontend is served.
CORS_ORIGIN="https://app.your-domain.example"

# Optional: set this to "true" during coordinated agent edits to freeze file watching
# and reduce hot-reload churn while multiple changes are being applied.
DISABLE_HMR="false"
