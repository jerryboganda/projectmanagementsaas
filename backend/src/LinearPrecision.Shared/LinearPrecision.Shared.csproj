<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Identity (User entity extends IdentityUser) -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.*" />
    <!-- EF Core (entity base types reference EF attributes) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Abstractions" Version="9.0.*" />
    <!-- MediatR contracts for domain events (INotification) -->
    <PackageReference Include="MediatR.Contracts" Version="2.0.1" />
  </ItemGroup>

</Project>
