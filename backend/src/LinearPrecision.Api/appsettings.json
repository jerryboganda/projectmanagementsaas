{
  // Production secrets MUST be supplied via environment variables, user secrets, or a vault.
  // Empty values here cause the API to fail fast at startup (see SecretsGuard in Program.cs).
  // Local development values live in appsettings.Development.json (gitignored env files preferred).
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "https://api.linearprecision.com",
    "Audience": "linear-precision-api",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7
  },
  "Storage": {
    "ServiceUrl": "",
    "BucketName": "linear-precision",
    "AccessKey": "",
    "SecretKey": ""
  },
  "Email": {
    "FromAddress": "noreply@linearprecision.com",
    "FromName": "Linear Precision",
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "Username": "",
      "Password": ""
    }
  },
  "Stripe": {
    "SecretKey": "",
    "PublishableKey": "",
    "WebhookSecret": ""
  },
  "AI": {
    "Provider": "GoogleGemini",
    "ApiKey": "",
    "ModelId": "gemini-1.5-flash"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.OpenTelemetry" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*"
}
